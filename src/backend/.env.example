# Copy to .env and set real values. Never commit the real file.
SECRET_KEY=replace-with-a-long-random-string
DATABASE_PATH=database/fresh_coders.sqlite
FLASK_ENV=development
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=8

# Turso cloud database (optional — uses local SQLite when not set)
# TURSO_DB_URL=libsql://<database>-<org>.aws-<region>.turso.io
# TURSO_AUTH_TOKEN=<db-scoped-token>

# Seed script credentials (development only).
SEED_ADMIN_PASSWORD=change-me
SEED_STAFF_PASSWORD=change-me
SEED_STUDENT_PASSWORD=change-me

# Frontend (.env in the frontend project)
# VITE_API_BASE_URL=http://localhost:5000
