# Fresh Coders 2.0 - Euphoria 2026 (KARE University)
# Netlify + backend host environment template.
#
# Copy the KEY=VALUE pairs you need into Netlify (Site settings > Environment
# variables) or into the Flask host dashboard. Replace every <placeholder>.
# Lines starting with # are comments and are ignored.

# ---------- NETLIFY (frontend build) ----------
# Empty value = demo mode with the in-browser backend (no server needed).
# Set the hosted Flask API base URL to switch the SPA to the real backend.
VITE_API_BASE_URL=

# ---------- BACKEND HOST (Flask API - Render / Railway / Fly.io / VPS) ----------
# Flask signing key - generate with:  python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=<long-random-string>
# production turns on fail-fast secret checks and disables the debugger
FLASK_ENV=production
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-site.netlify.app,http://localhost:5173
# Session lifetime in hours
SESSION_TTL_HOURS=8
# Local SQLite fallback path (only used when TURSO_DB_URL is not set)
DATABASE_PATH=database/fresh_coders.sqlite

# Turso cloud database (libsql) - the backend connects here when set
TURSO_DB_URL=libsql://<database>-<org>.aws-<region>.turso.io
TURSO_AUTH_TOKEN=<db-scoped-token>

# Seed-time demo passwords (dev only - used by src/backend/seed_database.py)
SEED_ADMIN_PASSWORD=<change-me>
SEED_STAFF_PASSWORD=<change-me>
SEED_STUDENT_PASSWORD=<change-me>
SEED_DEV_PASSWORD=<change-me>